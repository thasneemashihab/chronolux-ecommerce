<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link href="/css/adminExtras.css" rel="stylesheet">
  <title>Sales Report - Admin</title>
</head>
<body>
<%- include('../partials/adminSidebar', { active: 'salesReport' }) %>

<div class="admin-content p-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-white">Sales Report</h3>
    <div class="d-flex gap-2">
      <button class="btn btn-outline-success" id="exportExcelBtn"><i class="bi bi-file-earmark-excel me-1"></i> EXCEL</button>
      <button class="btn btn-outline-danger" id="exportPdfBtn"><i class="bi bi-file-earmark-pdf me-1"></i> PDF</button>
    </div>
  </div>

  <!-- Filters -->
  <div class="d-flex gap-2 mb-4 flex-wrap align-items-end">
    <div>
      <label class="form-label text-secondary small mb-1">Start Date</label>
      <input type="date" class="form-control" id="startDate">
    </div>
    <div>
      <label class="form-label text-secondary small mb-1">End Date</label>
      <input type="date" class="form-control" id="endDate">
    </div>
    <div>
      <label class="form-label text-secondary small mb-1">Order Status</label>
      <select class="form-select" id="statusFilter" style="width:180px;">
        <option value="">All Status</option>
        <option value="Pending">Pending</option>
        <option value="Processing">Processing</option>
        <option value="Shipped">Shipped</option>
        <option value="Delivered">Delivered</option>
        <option value="Cancelled">Cancelled</option>
        <option value="Returned">Returned</option>
      </select>
    </div>
    <div>
      <label class="form-label text-secondary small mb-1">Payment Method</label>
      <select class="form-select" id="paymentFilter" style="width:180px;">
        <option value="">All Payment Methods</option>
        <option value="COD">COD</option>
        <option value="Online">Online</option>
        <option value="Wallet">Wallet</option>
      </select>
    </div>
    <button class="btn btn-warning fw-bold" id="applyFilterBtn"><i class="bi bi-funnel me-1"></i> Apply Filter</button>
    <button class="btn btn-secondary" id="resetFilterBtn">Reset</button>
  </div>

  <!-- Summary cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-2-4" style="flex:0 0 20%;">
      <div class="p-3 rounded" style="background:#1a1a1a;">
        <p class="text-secondary small mb-1">Total Orders</p>
        <h4 class="fw-bold mb-0" id="statTotalOrders">0</h4>
      </div>
    </div>
    <div class="col-6" style="flex:0 0 20%;">
      <div class="p-3 rounded" style="background:#1a1a1a;">
        <p class="text-secondary small mb-1">Total Revenue</p>
        <h4 class="fw-bold text-warning mb-0">₹<span id="statTotalRevenue">0</span></h4>
      </div>
    </div>
    <div class="col-6" style="flex:0 0 20%;">
      <div class="p-3 rounded" style="background:#1a1a1a;">
        <p class="text-secondary small mb-1">Average Order Value</p>
        <h4 class="fw-bold mb-0">₹<span id="statAvgOrder">0</span></h4>
      </div>
    </div>
    <div class="col-6" style="flex:0 0 20%;">
      <div class="p-3 rounded" style="background:#1a1a1a;">
        <p class="text-secondary small mb-1">Total Discounts</p>
        <h4 class="fw-bold text-danger mb-0">₹<span id="statTotalDiscounts">0</span></h4>
      </div>
    </div>
    <div class="col-6" style="flex:0 0 20%;">
      <div class="p-3 rounded" style="background:#1a1a1a;">
        <p class="text-secondary small mb-1">Net Revenue</p>
        <h4 class="fw-bold text-success mb-0">₹<span id="statNetRevenue">0</span></h4>
      </div>
    </div>
  </div>

  <table class="table table-dark align-middle">
    <thead>
      <tr>
        <th>Order ID</th><th>Date</th><th>Customer</th><th>Payment</th><th>Items</th>
        <th>Subtotal</th><th>Discount</th><th>Shipping</th><th>Tax</th><th>Total</th><th>Status</th><th>Action</th>
      </tr>
    </thead>
    <tbody id="reportTableBody"></tbody>
  </table>

  <nav><ul class="pagination" id="reportPagination"></ul></nav>
</div>

<%- include('../partials/scripts') %>
<script src="/js/adminSalesReport.js"></script>
</body>
</html>