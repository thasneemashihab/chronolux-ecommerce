<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link href="/css/dashboard.css" rel="stylesheet">
  <title>Dashboard - Admin</title>
</head>
<body style="background:#0d0d0d; min-height:100vh;">

<div class="d-flex">
  <div class="admin-sidebar">
    <div class="text-center mb-4 px-3">
      <img src="/images/logo.png" width="36" class="mb-1" alt="logo">
      <h6 class="text-warning fw-bold mb-0">CHRONOLUX</h6>
      <small class="text-secondary">ADMIN PANEL</small>
    </div>
    <a href="/admin/dashboard" class="sidebar-link active"><i class="bi bi-grid"></i> Dashboard</a>
    <a href="/admin/products" class="sidebar-link"><i class="bi bi-box"></i> Products</a>
    <a href="/admin/inventory" class="sidebar-link"><i class="bi bi-archive"></i> Inventory</a>
    <a href="/admin/orders" class="sidebar-link"><i class="bi bi-bag"></i> Orders</a>
    <a href="/admin/users" class="sidebar-link"><i class="bi bi-people"></i> Users</a>
    <a href="/admin/coupons" class="sidebar-link"><i class="bi bi-ticket"></i> Coupon</a>
    <a href="/admin/categories" class="sidebar-link"><i class="bi bi-grid-3x3"></i> Category</a>
    <a href="/admin/offers" class="sidebar-link"><i class="bi bi-percent"></i> Offers</a>
    <a href="/admin/sales-report" class="sidebar-link"><i class="bi bi-bar-chart"></i> Sales Report</a>
    <a href="#" id="adminLogoutBtn" class="sidebar-link"><i class="bi bi-box-arrow-right"></i> Logout</a>
  </div>

  <div class="flex-grow-1 p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="fw-bold text-white">Dashboard</h3>
    </div>

    <!-- Filters -->
    <div class="d-flex gap-2 mb-4 flex-wrap align-items-end">
      <div>
        <label class="form-label text-secondary small mb-1">Start Date</label>
        <input type="date" class="form-control" id="dashStartDate">
      </div>
      <div>
        <label class="form-label text-secondary small mb-1">End Date</label>
        <input type="date" class="form-control" id="dashEndDate">
      </div>
      <button class="btn btn-warning fw-bold" id="dashApplyFilterBtn"><i class="bi bi-funnel me-1"></i> Apply Filter</button>
      <button class="btn btn-secondary" id="dashResetFilterBtn">Reset</button>
    </div>

    <!-- Top stats -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="p-3 rounded d-flex align-items-center gap-3" style="background:#1a1a1a;">
          <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:44px;height:44px;background:#2a2a2a;">₹</div>
          <div>
            <p class="text-secondary small mb-0">Total Revenue</p>
            <h5 class="fw-bold mb-0">₹<span id="statRevenue">0</span></h5>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="p-3 rounded d-flex align-items-center gap-3" style="background:#1a1a1a;">
          <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:44px;height:44px;background:#2a2a2a;"><i class="bi bi-bag"></i></div>
          <div>
            <p class="text-secondary small mb-0">Total Orders</p>
            <h5 class="fw-bold mb-0" id="statOrders">0</h5>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="p-3 rounded d-flex align-items-center gap-3" style="background:#1a1a1a;">
          <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:44px;height:44px;background:#2a2a2a;"><i class="bi bi-people"></i></div>
          <div>
            <p class="text-secondary small mb-0">Total Users</p>
            <h5 class="fw-bold mb-0" id="statUsers">0</h5>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="p-3 rounded d-flex align-items-center gap-3" style="background:#1a1a1a;">
          <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:44px;height:44px;background:#2a2a2a;"><i class="bi bi-mic"></i></div>
          <div>
            <p class="text-secondary small mb-0">Total Products</p>
            <h5 class="fw-bold mb-0" id="statProducts">0</h5>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
   <div class="col-md-7">
  <div class="p-3 rounded" style="background:#1a1a1a;">
    <h6 class="fw-bold mb-3">Revenue Overview</h6>
    <div style="height:220px;">
      <canvas id="revenueChart"></canvas>
    </div>
  </div>
</div>
<div class="col-md-5">
  <div class="p-3 rounded" style="background:#1a1a1a;">
    <h6 class="fw-bold mb-3">Orders Overview</h6>
    <div style="height:220px;">
      <canvas id="statusChart"></canvas>
    </div>
  </div>
</div>


    <!-- Top 10 lists -->
    <div class="row g-3">
      <div class="col-md-4">
        <div class="p-3 rounded" style="background:#1a1a1a;">
          <h6 class="fw-bold mb-3">Top 10 Best-Selling Products</h6>
          <div id="bestProductsList"></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-3 rounded" style="background:#1a1a1a;">
          <h6 class="fw-bold mb-3">Top 10 Best-Selling Categories</h6>
          <div id="bestCategoriesList"></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-3 rounded" style="background:#1a1a1a;">
          <h6 class="fw-bold mb-3">Top 10 Best-Selling Brands</h6>
          <div id="bestBrandsList"></div>
        </div>
      </div>
    </div>

  </div>
</div>



<%- include('../partials/scripts') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/main.js"></script>
<script src="/js/adminDashboard.js"></script>

</body>
</html>
