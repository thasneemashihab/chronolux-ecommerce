<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link href="/css/adminExtras.css" rel="stylesheet">
  <title>Coupons - Admin</title>
</head>
<body style="background:#0d0d0d; min-height:100vh;">

  <div class="d-flex">
  <div class="admin-sidebar">
    <div class="text-center mb-4 px-3">
      <img src="/images/logo.png" width="36" class="mb-1" alt="logo">
      <h6 class="text-warning fw-bold mb-0">CHRONOLUX</h6>
      <small class="text-secondary">ADMIN PANEL</small>
    </div>
    <a href="/admin/dashboard" class="sidebar-link"><i class="bi bi-grid"></i> Dashboard</a>
    <a href="/admin/products" class="sidebar-link"><i class="bi bi-box"></i> Products</a>
    <a href="/admin/inventory" class="sidebar-link"><i class="bi bi-archive"></i> Inventory</a>
    <a href="/admin/orders" class="sidebar-link"><i class="bi bi-bag"></i> Orders</a>
    <a href="/admin/users" class="sidebar-link"><i class="bi bi-people"></i> Users</a>
    <a href="/admin/coupons" class="sidebar-link active"><i class="bi bi-ticket"></i> Coupon</a>
    <a href="/admin/categories" class="sidebar-link"><i class="bi bi-grid-3x3"></i> Category</a>
    <a href="/admin/offers" class="sidebar-link"><i class="bi bi-percent"></i> Offers</a>
    <a href="/admin/sales-report" class="sidebar-link"><i class="bi bi-bar-chart"></i> Sales Report</a>
    <a href="#" id="adminLogoutBtn" class="sidebar-link"><i class="bi bi-box-arrow-right"></i> Logout</a>
  </div>

 <div class="flex-grow-1 p-4">
<div class="admin-content p-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-white">Coupons</h3>
    <button class="btn btn-warning fw-bold" id="openAddCouponBtn">+ Add Coupon</button>
  </div>

  <div class="d-flex gap-2 mb-3">
    <input type="text" class="form-control" id="couponSearch" placeholder="Search here" style="max-width:220px;">
    <select class="form-select" id="statusFilter" style="max-width:160px;">
      <option value="">All Status</option>
      <option value="true">Active</option>
      <option value="false">Inactive</option>
    </select>
    <select class="form-select" id="typeFilter" style="max-width:160px;">
      <option value="">All Type</option>
      <option value="percentage">Percentage</option>
      <option value="flat">Fixed</option>
    </select>
    <button class="btn btn-secondary" id="resetFiltersBtn">Reset</button>
  </div>

  <table class="table table-dark align-middle">
    <thead>
      <tr>
        <th>Coupon Name</th><th>Code</th><th>Type</th><th>Min. Purchase</th>
        <th>Max. Discount</th><th>Discount</th><th>Status</th><th>Action</th>
      </tr>
    </thead>
    <tbody id="couponsTableBody"></tbody>
  </table>
</div>

<!-- Add/Edit Coupon Modal -->
<div class="modal-backdrop-custom d-none" id="couponModalBackdrop">
  <div class="email-modal" style="max-width:650px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold mb-0" id="couponModalTitle">Add Coupon</h5>
      <button class="btn-close-modal" id="closeCouponModal">×</button>
    </div>
    <form id="couponForm" novalidate>
      <input type="hidden" id="editCouponId">

      <label class="form-label">Coupon Name *</label>
      <input type="text" class="form-control mb-3" id="couponName" placeholder="Enter coupon name">
      <div class="text-danger small mb-2" id="couponNameError"></div>

      <label class="form-label">Coupon Code *</label>
      <input type="text" class="form-control mb-1" id="couponCode" placeholder="Enter coupon code">
      <p class="text-secondary small mb-3">Customers will use this code to avail the offer.</p>
      <div class="text-danger small mb-2" id="couponCodeError"></div>

      <label class="form-label">Discount Type *</label>
      <select class="form-select mb-3" id="couponType">
        <option value="">Select discount type</option>
        <option value="percentage">Percentage</option>
        <option value="flat">Fixed</option>
      </select>
      <div class="text-danger small mb-2" id="couponTypeError"></div>

      <div class="row g-3 mb-1">
        <div class="col-6">
          <label class="form-label">Discount Value *</label>
          <input type="number" class="form-control" id="couponValue" placeholder="Enter value">
          <div class="text-danger small mb-2" id="couponValueError"></div>
        </div>
        <div class="col-6">
          <label class="form-label">Max Discount Amount</label>
          <input type="number" class="form-control" id="couponMaxDiscount" placeholder="Enter max discount">
          <div class="text-danger small mb-2" id="couponMaxDiscountError"></div>
        </div>
      </div>
      <p class="text-secondary small mb-3">Maximum discount limit for this coupon.</p>

      <label class="form-label">Min Purchase Amount *</label>
      <input type="number" class="form-control mb-1" id="couponMinOrder" placeholder="Enter minimum purchase amount">
      <p class="text-secondary small mb-3">Minimum cart amount to apply this coupon</p>
      <div class="text-danger small mb-2" id="couponMinOrderError"></div>

      <div class="row g-3 mb-3">
        <div class="col-6">
          <label class="form-label">Start Date *</label>
          <input type="date" class="form-control" id="couponStartDate">
          <div class="text-danger small mb-2" id="couponStartDateError"></div>
        </div>
        <div class="col-6">
          <label class="form-label">End Date *</label>
          <input type="date" class="form-control" id="couponValidTill">
          <div class="text-danger small mb-2" id="couponValidTillError"></div>
        </div>
      </div>

      <div class="d-flex align-items-center gap-2 mb-4">
        <label class="form-label mb-0">Status *</label>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="couponStatus" checked>
        </div>
        <span>Active</span>
      </div>

      <div class="alert alert-danger d-none" id="couponFormError"></div>

      <div class="d-flex gap-2">
        <button type="button" class="btn btn-secondary w-50" id="cancelCouponBtn">Cancel</button>
        <button type="submit" class="btn btn-warning fw-bold w-50" id="saveCouponBtn">Add Coupon</button>
      </div>
    </form>
  </div>
</div>
</div>
</div>

<%- include('../partials/scripts') %>
<script src="/js/main.js"></script>
<script src="/js/adminCoupons.js"></script>
</body>
</html>